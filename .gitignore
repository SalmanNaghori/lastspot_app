# ==============================================================================
# LastSpot / KhelBhai - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.class
*.log
*.pyc
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# FVM (Flutter Version Management)
# Keep fvm_config.json to ensure team consistency; ignore cached SDKs
.fvm/*
!.fvm/fvm_config.json

# ------------------------------------------------------------------------------
# Flutter & Dart Build Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android Platform
# ------------------------------------------------------------------------------
android/**/gradle-wrapper.jar
android/.gradle/
android/captures/
android/local.properties
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/
*.keystore
*.jks
android/key.properties

# ------------------------------------------------------------------------------
# iOS Platform
# ------------------------------------------------------------------------------
ios/.symlinks/
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/Service-Info.plist
*.ipa
*.dSYM.zip
*.dSYM

# ------------------------------------------------------------------------------
# Scratch, DevTools & Local Development Files
# ------------------------------------------------------------------------------
scratch/
devtools_options.yaml
*.tmp
*.bak
design_references/

# ------------------------------------------------------------------------------
# Environment & Secret Files
# ------------------------------------------------------------------------------
.env*

# ------------------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------------------
test/


<!-- reposeed:begin -->
# Keep the shared Graphify graph in Git; exclude machine-local state.
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
graphify-out/cache/
graphify-out/cost.json
graphify-out/memory/
graphify-out/reflections/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
<!-- reposeed:end -->
