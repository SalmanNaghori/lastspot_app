# ------------------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------------------
# Retain the local test baseline; include navigation and keyboard regression tests.
test/**
!test/**/
!test/core/widgets/khelbhai_back_button_test.dart
!test/core/widgets/app_keyboard_dismissal_test.dart
!test/features/startup/presentation/pages/onboarding_screen_test.dart
!test/features/spot/presentation/pages/spot_details_scroll_test.dart
!test/features/spot/presentation/pages/create_spot_insets_test.dart

<!-- reposeed:begin -->
# Keep the shared Graphify graph in Git; exclude machine-local state.
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
graphify-out/cache/
graphify-out/cost.json
graphify-out/memory/
graphify-out/reflections/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
