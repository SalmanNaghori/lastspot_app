# KhelBhai Environment Configuration Template
# Duplicate this file as .env or edit env/<target>.json

# Application Target (dev | staging | prod | local)
APP_ENV=dev
APP_NAME=KhelBhai (Dev)
APP_VERSION=1.0.3

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Visual Watermark Banner (true | false)
SHOW_BANNER=true

# Optional Gateway Base URL
API_BASE_URL=
