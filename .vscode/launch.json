{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KhelBhai (Dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      "name": "KhelBhai (Dev) + Banner",
